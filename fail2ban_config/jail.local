[DEFAULT]
# Importante para que no nos banee haciendo pruebas
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24 172.16.0.0/12


[n8n-soar-jail]
enabled = true
port = 5678,22,80,443
filter = n8n-soar-filter
logpath = /var/log/security/fail2ban.log
maxretry = 1
# LUEGO DE PRUEBAS CAMBIAR DE 120 A MAS ALTO
bantime = 600
bantime.increment = true
bantime.factor = 2
bantime.maxtime = 86400 
action = %(action_)s
         n8n-unban[name=soar]

