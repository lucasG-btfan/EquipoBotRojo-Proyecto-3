    {
      "parameters": {
        "jsCode": "const input = $input.first().json.datos_originales || $input.first().json;\n\n// 1. Extraer la IP atacante\nconst sourceIp = input.source_ip || \"0.0.0.0\";\n\n// 2. Sincronizar Prioridad con el Score (70 = HIGH)\nconst score = input.risk_score || 0;\nconst finalPriority = score >= 80 ? 'critical' : score >= 60 ?\n'high' : 'medium';\nconst ruleName = input.rule_name || \"\";\nconst blockDecision = input.block_decision || \"\";\n\n// Eventos que generan bloqueo → resolved\n// Eventos de sistema sin bloqueo → open\nconst eventosConBloqueo = [\n  'Root Login Attempt',\n  'SSH Failed Password', \n  'Access Denied',\n  'Port Scan',\n  'Iptables Drop'\n];\n\nconst statusTicket = (eventosConBloqueo.includes(ruleName) || blockDecision === 'block') \n  ? 'resolved' \n  : 'open';\nreturn [{\n    json: {\n        ticket_number: 'TICKET-LOG-' + Math.random().toString(36).substr(2, 6).toUpperCase(),\n        title: `[DETECCIÓN] ${input.rule_name || \"Ataque SSH\"}`,\n        description: input.description,\n        status: statusTicket,\n        priority: $('Definir campo de origen').first().json.datos_originales.severity,\n        category: `HIDS/Logs-${input.rule_name}`,\n        source_ip: sourceIp,\n        threat_score: score,\n        assigned_to: 'rafa.legendsss@gmail.com',\n        created_at: new Date().toISOString(),\n        alert_reference: input.alert_reference\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        48
      ],
      "id": "71464a8d-b318-4235-b825-c757002c37a0",
