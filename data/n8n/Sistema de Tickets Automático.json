    {
      "parameters": {
        "jsCode": "const ticket = $('Construir mensaje Prometheus').first().json;\n\nif (ticket.category === 'IpBaneadaDetectada') {\n  return [{ \n    json: { \n      success: true, \n      message: \"Ticket omitido: IpBaneadaDetectada no se envía a Kibana para evitar ruido.\" \n    } \n  }];\n}\n\nlet originalRuleName = \"Alerta Métrica Prometheus\";\ntry {\n  const primerNodo = $('Definir campo de origen').first().json;\n  if (primerNodo.datos_originales?.alerts && primerNodo.datos_originales.alerts.length > 0) {\n    const primeraAlerta = primerNodo.datos_originales.alerts[0];\n    originalRuleName = primeraAlerta.labels?.alertname || primerNodo.datos_originales.commonLabels?.alertname || \"Prometheus Alert\";\n  }\n} catch (e) {\n  originalRuleName = ticket.title || \"Prometheus Alert\";\n}\n\ntry {\n  await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://logstash:8080',\n    body: {\n      ...ticket,\n      rule_name: originalRuleName, \n      type: 'ticket_created',\n      source: 'prometheus_alertmanager',\n      timestamp: new Date().toISOString()\n    },\n    json: true \n  });\n} catch (error) {\n  throw new Error('Error enviando ticket a Logstash: ' + error.message);\n}\n\n// 5. Respuesta de éxito con los datos reales\nreturn [{ \n  json: {\n    success: true,\n    ticket_number: ticket.ticket_number,\n    message: `Ticket de métricas ${ticket.ticket_number} enviado a Logstash exitosamente`,\n    details: {\n      priority: ticket.priority,\n      category: ticket.category,\n      rule_name: originalRuleName,\n      assigned_to: ticket.assigned_to,\n      timestamp: new Date().toISOString()\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        368
      ],
      "id": "b5d811ef-eaf7-4c8f-9c9b-07f42e2de894",
      "name": "Finalizar Proceso Prometheus/Alertmanager"
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Insertar Ticket en BD').first().json; \nconst originalRuleName = $('Definir campo de origen').first().json.datos_originales.rule_name;\n\ntry {\n  await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'http://logstash:8080',\n    body: {\n      ...ticket,\n      rule_name: originalRuleName, \n      type: 'ticket_created',\n      source: 'n8n_ticket_system',\n      timestamp: new Date().toISOString()\n    },\n    json: true \n  });\n} catch (error) {\n  throw new Error('Error enviando ticket a Logstash: ' + error.message);\n}\n\nconst response = {\n  success: true,\n  ticket_number: ticket.ticket_number,\n  message: `Ticket ${ticket.ticket_number} creado exitosamente`,\n  details: {\n    priority: ticket.priority,\n    category: ticket.category,\n    rule_name: originalRuleName,\n    assigned_to: ticket.assigned_to,\n    timestamp: new Date().toISOString()\n  }\n};\n\nreturn [{ json: response }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        176
      ],
      "id": "3246733b-0cdc-4a3a-980c-eeadf72b17b0",
      "name": "Finalizar Proceso N8N"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\nconst alert = input[0].json;\n\nconst alertname = alert.labels?.alertname || \n                  alert.commonLabels?.alertname || \n                  alert.groupLabels?.alertname || \n                  'Unknown';\n\nconst mensajes = {\n  'IpBaneadaDetectada': {\n    title: `[BANEO] IPs baneadas en Jail: ${alert.labels?.jail || 'n8n-auth-jail'}`,\n    description: `Prometheus detectó IPs baneadas. Revisar tickets de logs para detalles.`,\n    priority: 'medium'\n  },\n  'Fail2banCaido': {\n    title: `[CRÍTICO] Fail2ban está caído`,\n    description: `El servicio fail2ban no responde. El sistema de bloqueo automático está inactivo.`,\n    priority: 'critical'\n  },\n  'AtaqueMasivo': {\n    title: `[ATAQUE MASIVO] Más de 10 IPs baneadas simultáneamente`,\n    description: `Prometheus detectó un volumen anormal de baneos. Posible ataque coordinado.`,\n    priority: 'critical'\n  }\n};\n\nconst info = mensajes[alertname] || {\n  title: `[ALERTA] ${alertname}`,\n  description: `Alerta de Prometheus: ${alertname}`,\n  priority: 'medium'\n};\n\nreturn {\n  json: {\n    ticket_number: 'TICKET-METRICA-' + Math.random().toString(36).substr(2, 6).toUpperCase(),\n    title: info.title,\n    description: info.description,\n    status: info.priority === 'critical' ? 'urgent' : 'open',\n    priority: info.priority,\n    category: 'IPS/Metrics',\n    source_ip: 'Prometheus',\n    threat_score: info.priority === 'critical' ? 100 : 50,\n    assigned_to: 'security_team@example.com',\n    created_at: new Date().toISOString(),\n    alert_reference: null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        224
      ],
      "id": "7f5f7186-c43c-43bc-b5b4-8245ce16bdc6",
      "name": "Construir mensaje Prometheus"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\n// Detectar el origen y lo guardamos en una palabra simple\nlet origen = \"otro\";\n\nif (body.alerts) {\n    origen = \"alertmanager\";\n} else if (body.rule_name) {\n    origen = \"workflow_logs\";\n}\n\n// Enviar la palabra limpia y los datos originales\nreturn {\n    origen_ticket: origen,\n    datos_originales: body\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
